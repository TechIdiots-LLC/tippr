# tippr Docker Compose settings. Copy to .env and fill in.

# --- required ---------------------------------------------------------------
# the site's domain (must contain a dot)
TIPPR_DOMAIN=tippr.example.com
# passwords for the PostgreSQL and RabbitMQ containers (any long random
# strings; generate with: openssl rand -hex 24)
TIPPR_DB_PASSWORD=
TIPPR_AMQP_PASSWORD=

# --- TLS --------------------------------------------------------------------
# an email address to get a Let's Encrypt certificate (the domain must point
# at this server, ports 80 and 443 reachable), or "internal" for a
# self-signed one
TIPPR_TLS=internal
TIPPR_HTTP_PORT=80
TIPPR_HTTPS_PORT=443

# --- image ------------------------------------------------------------------
TIPPR_IMAGE=techidiotsllc/tippr
# a release (e.g. 1.0.0), or latest
TIPPR_VERSION=latest

# --- site -------------------------------------------------------------------
# production, or development (debug pages, no captcha or rate limits)
TIPPR_ENVIRONMENT=production
TIPPR_SITE_NAME=tippr
TIPPR_SITE_DESCRIPTION=
TIPPR_CONTACT_EMAIL=
# the admin account; its password is generated into the config volume's
# secrets.env unless you set it here
TIPPR_ADMIN_USER=tippr
#TIPPR_ADMIN_PASSWORD=

# --- sizing -----------------------------------------------------------------
# gunicorn workers (default: CPU count, at most 8)
#TIPPR_WEB_WORKERS=4
# extra queue consumers, e.g. vote_link_q=2,automoderator_q=1. With an
# ini's shard_<queue>_queues on, add ten of that queue's shard consumers
# (commentstree_shard_q=10, author_query_shard_q=10, vault_query_shard_q=10,
# domain_query_shard_q=10); until they run, items stay on the main queue.
#TIPPR_CONSUMERS=
TIPPR_CASSANDRA_HEAP=1G
TIPPR_OPENSEARCH_HEAP=1g
TIPPR_MEMCACHED_MB=256
