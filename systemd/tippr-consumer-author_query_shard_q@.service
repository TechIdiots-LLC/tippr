[Unit]
Description=update links by author precomputed queries, one shard (instance n = shard n-1)
PartOf=tippr.target
After=network.target

[Service]
Type=simple
User=@TIPPR_USER@
Group=@TIPPR_GROUP@
EnvironmentFile=-/etc/default/tippr
WorkingDirectory=@TIPPR_ROOT@
ExecStart=@TIPPR_VENV@/bin/paster --plugin=r2 run --proctitle author_query_shard_q%i ${TIPPR_INI} @TIPPR_ROOT@/r2/lib/voting.py -c "consume_author_query_queue(qname=query_shard_queue('author', %i))"
Restart=always
Nice=10

[Install]
WantedBy=tippr.target
