[Unit]
Description=Collect events and publish them elsewhere for processing
PartOf=tippr.target
After=network.target

[Service]
Type=simple
User=@TIPPR_USER@
Group=@TIPPR_GROUP@
EnvironmentFile=-/etc/default/tippr
WorkingDirectory=@TIPPR_ROOT@
ExecStart=/usr/bin/python3 @TIPPR_SRC@/tippr/scripts/wrap-job paster run --proctitle event_collector_q%i ${TIPPR_INI} @TIPPR_ROOT@/r2/lib/eventcollector.py -c 'from pylons import app_globals; process_events(app_globals, limit=100)'
Restart=always
Nice=10

[Install]
WantedBy=tippr.target
