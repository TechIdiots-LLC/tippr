[Unit]
Description=Collect events and publish them elsewhere for processing
PartOf=tippr.target
After=network.target postgresql.service cassandra.service zookeeper.service rabbitmq-server.service memcached.service
# keep restarting while the data stores come up (wait-for-stores)
StartLimitIntervalSec=0

[Service]
Type=simple
User=@TIPPR_USER@
Group=@TIPPR_GROUP@
EnvironmentFile=-/etc/default/tippr
WorkingDirectory=@TIPPR_ROOT@
ExecStartPre=@TIPPR_VENV@/bin/python @TIPPR_SRC@/tippr/scripts/wait-for-stores
ExecStart=@TIPPR_VENV@/bin/python -m r2.commands --proctitle event_collector_q%i ${TIPPR_INI} @TIPPR_ROOT@/r2/lib/eventcollector.py -c 'from pylons import app_globals; process_events(app_globals, limit=100)'
Restart=always
RestartSec=5
TimeoutStartSec=360
Nice=10

[Install]
WantedBy=tippr.target
