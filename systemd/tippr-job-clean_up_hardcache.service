[Unit]
Description=remove expired tokens from hardcache

After=network.target

[Service]
Type=oneshot
User=@TIPPR_USER@
Group=@TIPPR_GROUP@
EnvironmentFile=-/etc/default/tippr
WorkingDirectory=@TIPPR_ROOT@
ExecStart=@TIPPR_VENV@/bin/paster run ${TIPPR_INI} -c 'from r2.lib.hardcachebackend import delete_expired; delete_expired()'

Nice=10

