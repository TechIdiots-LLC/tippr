[Unit]
Description=place new comments on fastlane_links threads in their comment trees
PartOf=tippr.target
After=network.target

[Service]
Type=simple
User=@TIPPR_USER@
Group=@TIPPR_GROUP@
EnvironmentFile=-/etc/default/tippr
WorkingDirectory=@TIPPR_ROOT@
Environment=type=commentstree_fastlane_q
ExecStart=@TIPPR_VENV@/bin/python -m r2.commands --proctitle ${type}%i ${TIPPR_INI} @TIPPR_ROOT@/r2/lib/db/queries.py -c "run_commentstree(qname='${type}')"
Restart=always
Nice=10

[Install]
WantedBy=tippr.target
