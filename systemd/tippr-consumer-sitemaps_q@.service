[Unit]
Description=build sitemaps for almost every link on tippr
PartOf=tippr.target
After=network.target

[Service]
Type=simple
User=@TIPPR_USER@
Group=@TIPPR_GROUP@
EnvironmentFile=-/etc/default/tippr
WorkingDirectory=@TIPPR_ROOT@
ExecStart=/usr/bin/python3 @TIPPR_SRC@/tippr/scripts/wrap-job paster run --proctitle sitemaps_q%i ${TIPPR_INI} @TIPPR_ROOT@/r2/lib/sitemaps/watcher.py -c 'watcher()'
Restart=always
Nice=10

[Install]
WantedBy=tippr.target
