[Unit]
Description=process hourly traffic logs on EMR

After=network.target

[Service]
Type=oneshot
User=@TIPPR_USER@
Group=@TIPPR_GROUP@
EnvironmentFile=-/etc/default/tippr
WorkingDirectory=@TIPPR_ROOT@
# run-locked: on one server at a time when several share the site
ExecStart=@TIPPR_VENV@/bin/python @TIPPR_SRC@/tippr/scripts/run-locked hourly_traffic-%i @TIPPR_VENV@/bin/paster --plugin=r2 run ${TIPPR_INI} -c "from r2.lib.traffic import process_hour; process_hour(\"%i\")"

Nice=10

