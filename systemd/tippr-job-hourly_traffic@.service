[Unit]
Description=process hourly traffic logs on EMR

After=network.target

[Service]
Type=oneshot
User=@TIPPR_USER@
Group=@TIPPR_GROUP@
EnvironmentFile=-/etc/default/tippr
WorkingDirectory=@TIPPR_ROOT@
ExecStart=/usr/bin/python3 @TIPPR_SRC@/tippr/scripts/wrap-job paster run ${TIPPR_INI} -c "from r2.lib.traffic import process_hour; process_hour(\"%i\")"

Nice=10

[Install]
WantedBy=tippr.target
