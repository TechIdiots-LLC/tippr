[Unit]
Description=find thumbnails/embedded content for newly submitted links
PartOf=tippr.target
After=network.target

[Service]
Type=simple
User=@TIPPR_USER@
Group=@TIPPR_GROUP@
EnvironmentFile=-/etc/default/tippr
WorkingDirectory=@TIPPR_ROOT@
ExecStart=@TIPPR_VENV@/bin/paster run --proctitle scraper_q%i ${TIPPR_INI} @TIPPR_ROOT@/r2/lib/media.py -c 'run()'
Restart=always
Nice=10

[Install]
WantedBy=tippr.target
