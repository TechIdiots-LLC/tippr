[Unit]
Description=Update the popular vaults.

After=network.target

[Service]
Type=oneshot
User=@TIPPR_USER@
Group=@TIPPR_GROUP@
EnvironmentFile=-/etc/default/tippr
WorkingDirectory=@TIPPR_ROOT@
# run-locked: on one server at a time when several share the site
ExecStart=@TIPPR_VENV@/bin/python @TIPPR_SRC@/tippr/scripts/run-locked update_popular_vaults @TIPPR_VENV@/bin/python -m r2.commands ${TIPPR_INI} -c 'from r2.models.vault import Vault; Vault.update_popular_vaults()'

Nice=10

