[Unit]
Description=Update the popular vaults.

After=network.target

[Service]
Type=oneshot
User=@TIPPR_USER@
Group=@TIPPR_GROUP@
EnvironmentFile=-/etc/default/tippr
WorkingDirectory=@TIPPR_ROOT@
ExecStart=@TIPPR_VENV@/bin/paster --plugin=r2 run ${TIPPR_INI} -c 'from r2.models.vault import Vault; Vault.update_popular_vaults()'

Nice=10

