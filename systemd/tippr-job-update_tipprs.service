[Unit]
Description=update /vaults sort scores

After=network.target

[Service]
Type=oneshot
User=@TIPPR_USER@
Group=@TIPPR_GROUP@
EnvironmentFile=-/etc/default/tippr
WorkingDirectory=@TIPPR_ROOT@
ExecStart=@TIPPR_VENV@/bin/paster run ${TIPPR_INI} -c 'from r2.lib import vault_pops; vault_pops.run()'

Nice=10

