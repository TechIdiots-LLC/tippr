[Unit]
Description=update links by vault precomputed queries
PartOf=tippr.target
After=network.target postgresql.service cassandra.service zookeeper.service rabbitmq-server.service memcached.service
# keep restarting while the data stores come up (wait-for-stores)
StartLimitIntervalSec=0

[Service]
Type=simple
User=@TIPPR_USER@
Group=@TIPPR_GROUP@
EnvironmentFile=-/etc/default/tippr
WorkingDirectory=@TIPPR_ROOT@
ExecStartPre=@TIPPR_VENV@/bin/python @TIPPR_SRC@/tippr/scripts/wait-for-stores
ExecStart=@TIPPR_VENV@/bin/python -m r2.commands --proctitle vault_query_q%i ${TIPPR_INI} @TIPPR_ROOT@/r2/lib/voting.py -c "consume_vault_query_queue()"
Restart=always
RestartSec=5
TimeoutStartSec=360
Nice=10

[Install]
WantedBy=tippr.target
