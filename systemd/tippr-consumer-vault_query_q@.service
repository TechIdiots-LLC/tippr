[Unit]
Description=update links by vault precomputed queries
PartOf=tippr.target
After=network.target

[Service]
Type=simple
User=@TIPPR_USER@
Group=@TIPPR_GROUP@
EnvironmentFile=-/etc/default/tippr
WorkingDirectory=@TIPPR_ROOT@
ExecStart=@TIPPR_VENV@/bin/paster --plugin=r2 run --proctitle vault_query_q%i ${TIPPR_INI} @TIPPR_ROOT@/r2/lib/voting.py -c "consume_vault_query_queue()"
Restart=always
Nice=10

[Install]
WantedBy=tippr.target
