[Unit]
Description=find and delete new broken things (usually caused by failed transactions)

After=network.target

[Service]
Type=oneshot
User=@TIPPR_USER@
Group=@TIPPR_GROUP@
EnvironmentFile=-/etc/default/tippr
WorkingDirectory=@TIPPR_ROOT@
ExecStart=@TIPPR_VENV@/bin/paster --plugin=r2 run ${TIPPR_INI} -c 'from r2.lib.utils import utils; utils.find_recent_broken_things(delete=True)'

Nice=10

