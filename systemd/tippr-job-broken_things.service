[Unit]
Description=find and delete new broken things (usually caused by failed transactions)

After=network.target postgresql.service cassandra.service zookeeper.service rabbitmq-server.service memcached.service

[Service]
Type=oneshot
User=@TIPPR_USER@
Group=@TIPPR_GROUP@
EnvironmentFile=-/etc/default/tippr
WorkingDirectory=@TIPPR_ROOT@
ExecStartPre=@TIPPR_VENV@/bin/python @TIPPR_SRC@/tippr/scripts/wait-for-stores
# run-locked: on one server at a time when several share the site
ExecStart=@TIPPR_VENV@/bin/python @TIPPR_SRC@/tippr/scripts/run-locked broken_things @TIPPR_VENV@/bin/python -m r2.commands ${TIPPR_INI} -c 'from r2.lib.utils import utils; utils.find_recent_broken_things(delete=True)'

Nice=10

