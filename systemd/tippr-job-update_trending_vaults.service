[Unit]
Description=Update the current trending vaults cache.

After=network.target

[Service]
Type=oneshot
User=@TIPPR_USER@
Group=@TIPPR_GROUP@
EnvironmentFile=-/etc/default/tippr
WorkingDirectory=@TIPPR_ROOT@
# run-locked: on one server at a time when several share the site
ExecStart=@TIPPR_VENV@/bin/python @TIPPR_SRC@/tippr/scripts/run-locked update_trending_vaults @TIPPR_VENV@/bin/python -m r2.commands ${TIPPR_INI} -c 'from r2.lib.trending import update_trending_vaults; update_trending_vaults()'

Nice=10

