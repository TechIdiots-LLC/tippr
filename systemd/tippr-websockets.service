[Unit]
Description=Tippr Websockets Service
Wants=network-online.target
After=network-online.target tippr.target
PartOf=tippr.target

[Service]
Type=simple
User=@TIPPR_USER@
Group=@TIPPR_GROUP@
WorkingDirectory=@TIPPR_SRC@/websockets
EnvironmentFile=-/etc/default/tippr
# /etc/default/tippr puts the tippr tree first on PYTHONPATH, where its
# baseplate/ compatibility shim for r2 would shadow the real baseplate this
# service runs on.
UnsetEnvironment=PYTHONPATH
Environment=PROMETHEUS_MULTIPROC_DIR=/tmp/prometheus_tippr
ExecStartPre=+/bin/mkdir -p /tmp/prometheus_tippr
ExecStartPre=+/bin/chown @TIPPR_USER@:@TIPPR_GROUP@ /tmp/prometheus_tippr
ExecStart=@TIPPR_VENV@/bin/baseplate-serve --bind 127.0.0.1:9001 @TIPPR_SRC@/websockets/tippr.ini
Restart=on-failure
TimeoutStartSec=120

[Install]
WantedBy=tippr.target
