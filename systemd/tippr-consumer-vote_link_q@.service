[Unit]
Description=process votes cast on links
PartOf=tippr.target
After=network.target

[Service]
Type=simple
User=@TIPPR_USER@
Group=@TIPPR_GROUP@
EnvironmentFile=-/etc/default/tippr
WorkingDirectory=@TIPPR_ROOT@
ExecStart=/usr/bin/python3 @TIPPR_SRC@/tippr/scripts/wrap-job paster run --proctitle vote_link_q%i ${TIPPR_INI} -c 'from r2.lib.voting import consume_link_vote_queue; consume_link_vote_queue()'
Restart=always
Nice=10

[Install]
WantedBy=tippr.target
