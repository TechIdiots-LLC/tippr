[Unit]
Description=Tippr API (paster)
After=network.target tippr.target
PartOf=tippr.target

[Service]
Type=simple
User=@TIPPR_USER@
Group=@TIPPR_GROUP@
WorkingDirectory=@TIPPR_ROOT@
EnvironmentFile=-/etc/default/tippr
ExecStart=@TIPPR_VENV@/bin/paster serve --reload ${TIPPR_INI}
Restart=always

[Install]
WantedBy=tippr.target
