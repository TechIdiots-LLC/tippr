[Unit]
Description=Tippr web app (gunicorn)
After=network.target tippr.target postgresql.service cassandra.service zookeeper.service rabbitmq-server.service memcached.service
PartOf=tippr.target
# keep restarting while the data stores come up (wait-for-stores)
StartLimitIntervalSec=0

[Service]
Type=simple
User=@TIPPR_USER@
Group=@TIPPR_GROUP@
WorkingDirectory=@TIPPR_ROOT@
EnvironmentFile=-/etc/default/tippr
ExecStartPre=@TIPPR_VENV@/bin/python @TIPPR_SRC@/tippr/scripts/wait-for-stores
# TIPPR_WEB_WORKERS and TIPPR_GUNICORN_ARGS ("--reload" in development) come
# from /etc/default/tippr. nginx, on the same host, is the only client.
ExecStart=@TIPPR_VENV@/bin/gunicorn --paste ${TIPPR_INI} \
    --bind 127.0.0.1:8001 \
    --workers ${TIPPR_WEB_WORKERS} \
    --timeout 60 \
    --graceful-timeout 30 \
    $TIPPR_GUNICORN_ARGS
ExecReload=/bin/kill -HUP $MAINPID
KillMode=mixed
Restart=always
RestartSec=5
TimeoutStartSec=360

[Install]
WantedBy=tippr.target
