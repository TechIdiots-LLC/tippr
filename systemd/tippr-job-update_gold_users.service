[Unit]
Description=trigger notification of impending expiration or actual expiration for gold membership

After=network.target postgresql.service cassandra.service zookeeper.service rabbitmq-server.service memcached.service

[Service]
Type=oneshot
User=@TIPPR_USER@
Group=@TIPPR_GROUP@
EnvironmentFile=-/etc/default/tippr
WorkingDirectory=@TIPPR_ROOT@
ExecStartPre=@TIPPR_VENV@/bin/python @TIPPR_SRC@/tippr/scripts/wait-for-stores
# run-locked: on one server at a time when several share the site
ExecStart=@TIPPR_VENV@/bin/python @TIPPR_SRC@/tippr/scripts/run-locked update_gold_users @TIPPR_VENV@/bin/python -m r2.commands ${TIPPR_INI} -c 'from r2.models import update_gold_users; update_gold_users()'

Nice=10

