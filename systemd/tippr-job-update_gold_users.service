[Unit]
Description=trigger notification of impending expiration or actual expiration for gold membership

After=network.target

[Service]
Type=oneshot
User=@TIPPR_USER@
Group=@TIPPR_GROUP@
EnvironmentFile=-/etc/default/tippr
WorkingDirectory=@TIPPR_ROOT@
ExecStart=/usr/bin/python3 @TIPPR_SRC@/tippr/scripts/wrap-job paster run ${TIPPR_INI} -c 'from r2.models import update_gold_users; update_gold_users()'

Nice=10

[Install]
WantedBy=tippr.target
