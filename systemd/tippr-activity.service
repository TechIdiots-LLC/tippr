[Unit]
Description=Tippr Activity Service
Wants=network-online.target
After=network-online.target tippr.target
PartOf=tippr.target

[Service]
Type=simple
User=@TIPPR_USER@
Group=@TIPPR_GROUP@
WorkingDirectory=@TIPPR_SRC@/activity
EnvironmentFile=-/etc/default/tippr
# /etc/default/tippr puts the tippr tree first on PYTHONPATH, where its
# baseplate/ compatibility shim for r2 would shadow the real baseplate this
# service runs on.
UnsetEnvironment=PYTHONPATH
ExecStart=@TIPPR_VENV@/bin/baseplate-serve --bind 127.0.0.1:9002 @TIPPR_SRC@/activity/example.ini
Restart=on-failure
TimeoutStartSec=120

[Install]
WantedBy=tippr.target
