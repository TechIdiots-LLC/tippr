[Unit]
Description=report this server's state for /admin/servers

After=network.target

[Service]
Type=oneshot
User=@TIPPR_USER@
Group=@TIPPR_GROUP@
EnvironmentFile=-/etc/default/tippr
WorkingDirectory=@TIPPR_ROOT@
# on every server (no run-locked): each reports itself. It doesn't load the
# app, so it's quick.
ExecStart=@TIPPR_VENV@/bin/python @TIPPR_SRC@/tippr/scripts/server_status.py ${TIPPR_INI}

Nice=10
