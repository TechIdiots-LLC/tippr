[Unit]
Description=process privacy data export requests
PartOf=tippr.target
After=network.target

[Service]
Type=simple
User=@TIPPR_USER@
Group=@TIPPR_GROUP@
EnvironmentFile=-/etc/default/tippr
WorkingDirectory=@TIPPR_ROOT@
ExecStart=/usr/bin/python3 @TIPPR_SRC@/tippr/scripts/wrap-job paster run --proctitle privacy_export_q%i ${TIPPR_INI} -c 'from r2.lib.privacy_export_consumer import run; run()'
Restart=always
Nice=10

[Install]
WantedBy=tippr.target
