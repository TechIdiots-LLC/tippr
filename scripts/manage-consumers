#!/bin/bash

# If being called from a systemd service, the first argument should be the action.
# Otherwise, we can try to infer it.
action=${1:-start}

if [ -f /etc/default/tippr ]; then
    . /etc/default/tippr
fi

if [ -z "$TIPPR_CONSUMER_CONFIG" ] || [ "$TIPPR_CONSUMER_CONFIG" = "/" ]; then
    echo "TIPPR_CONSUMER_CONFIG is not set correctly. Exiting."
    exit 0
fi

if [ ! -d "$TIPPR_CONSUMER_CONFIG" ]; then
    echo "TIPPR_CONSUMER_CONFIG directory $TIPPR_CONSUMER_CONFIG does not exist. Exiting."
    exit 0
fi

# Use a more explicit loop to avoid issues with empty directories or unexpected paths.
for consumerpath in "$TIPPR_CONSUMER_CONFIG"/*; do
    # Skip if the glob didn't match anything
    [ -e "$consumerpath" ] || continue
    # Only process directories in the config root
    [ -d "$consumerpath" ] || continue
    
    consumer=$(basename "$consumerpath")

    # allow targeting which consumer the event is meant for (defaulting to 'all')
    if [ ! -z "$TARGET" ] && [ "$TARGET" != "all" ] && [ "$TARGET" != "$consumer" ]; then
        continue
    fi

    # Inner loop for types (e.g. author_query_q, etc.)
    for typepath in "$consumerpath"/*; do
        [ -f "$typepath" ] || continue
        
        instance_count=$(cat "$typepath")
        type_=$(basename "$typepath")

        # Ensure instance_count is a number and greater than 0
        if [[ "$instance_count" =~ ^[0-9]+$ ]] && [ "$instance_count" -gt 0 ]; then
            for i in $(seq 1 "$instance_count"); do
                systemctl "$action" "tippr-consumer-$consumer@$i"
            done
        fi
    done
done

